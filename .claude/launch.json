{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "faforever-rust-client-ui",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "faforever-rust-client-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "FAF_FAKE_AUTH=1 FAF_REAL_LOBBY= FAF_REAL_LAUNCH= pnpm tauri dev"
      ],
      "port": 5173
    },
    {
      "name": "faforever-rust-client-tourney-local",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "TOURNEY_API_BASE=http://localhost:8090 pnpm tauri dev"
      ],
      "port": 5173
    },
    {
      "name": "faforever-rust-client-tourney-live",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "pnpm tauri dev"
      ],
      "port": 5173
    }
  ]
}
